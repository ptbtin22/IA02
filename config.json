{
  "mcpServers": {
    "weather-stdio": {
      "command": "npx",
      "args": ["tsx", "weather-server.ts"]
    },
    "football-stdio": {
      "command": "npx",
      "args": ["tsx", "src/football-server.ts"]
    },
    "todo-http-public": {
      "url": "https://todo-mcp-http.onrender.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_KEY}"
      }
    }
  }
}
